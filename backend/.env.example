# Copy to .env and fill in with your real values. Never commit .env.

# --- App ---
PORT=4000
APP_URL=https://www.raftgear.co.za          # your live domain, used to build PayFast return/cancel/notify URLs
NODE_ENV=production

# --- PayFast (get these from your PayFast merchant dashboard) ---
# Use the sandbox values below while testing:
#   PAYFAST_MERCHANT_ID=10000100
#   PAYFAST_MERCHANT_KEY=46f0cd694581a
#   PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_passphrase          # set in PayFast dashboard under Settings > Security
PAYFAST_MODE=sandbox                        # sandbox | live

# --- Database ---
# This scaffold ships with a JSON-file store (lib/db.js) purely so the API
# runs with zero setup. Swap DATABASE_URL in for Postgres/MySQL before
# taking real orders — see README "Going to production".
DATABASE_URL=postgres://user:password@localhost:5432/raft

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string
